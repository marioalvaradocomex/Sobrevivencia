library(readxl)
library(dplyr)
library(tidyverse)
base <- read_xlsx("C:/Users/Mario.alvarado/OneDrive - Ministerio de Comercio Exterior/Monitoreo/Pagina Web/Aranceles/CRI - notificación arancel 2023.xlsx",sheet="2023")
base  <- base %>% filter(nchar(PARTIDA)==12)
base$subpartida_8d <- substr(base$PARTIDA,1,8)
a_promedio <- base %>% group_by(subpartida_8d, Sector) %>% summarise (Dai_max= max(DAI)) %>% ungroup()
mean(a_promedio$Dai_max)
a_promedio <- a_promedio %>% mutate (rango= case_when(Dai_max == 0 ~"Igual a 0%",
Dai_max >= 1 & Dai_max <= 5 ~ "+0% pero menor o igual a 5%",
Dai_max >= 6 & Dai_max <= 10 ~ "+5% pero menor o igual a 10%",
Dai_max >= 11 & Dai_max <= 15 ~ "+10% pero menor o igual a 15%",
Dai_max >= 16 & Dai_max <= 25 ~ "+15% pero menor o igual a 25%",
Dai_max >= 26 & Dai_max <= 50 ~ "+25% pero menor o igual a 50%",
Dai_max >= 51 & Dai_max <= 100 ~"+50% pero menor o igual a 100%",
TRUE ~ "+100"))
npartidas <- a_promedio %>% group_by(rango) %>% count(subpartida_8d) %>% ungroup()
npartidas <- npartidas %>% group_by(rango) %>% summarise(conteo = n()); npartidas
sum(npartidas$conteo)
a_sector <- a_promedio %>% group_by(Sector)  %>% summarise (s_arancel= mean(Dai_max)) %>% ungroup(); a_sector
base %>% group_by(Sector) %>% summarise (suma = sum(Valor*DAI/100))
sum(base$Recaudación)
a_sector <- a_promedio %>% group_by(Sector)  %>% summarise (s_arancel= mean(Dai_max)) %>% ungroup(); a_sector
