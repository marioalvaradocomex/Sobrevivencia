# Verificar si el verdadero valor de β está dentro del intervalo
if (lower_limit <= beta && beta <= upper_limit) {
count_in_intervals <- count_in_intervals + 1
}
}
proportion_in_intervals <- count_in_intervals / n_samples
cat("Proporción de intervalos que contienen el verdadero valor de β:", proportion_in_intervals, "\n")
